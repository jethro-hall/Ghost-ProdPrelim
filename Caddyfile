:80 {
	encode gzip
	handle /ghost_chatui {
		redir https://ghoststack.rideai.com.au/ghost_chatui/ 308
	}
	handle /ghost_chatui/* {
		redir https://ghoststack.rideai.com.au{uri} 308
	}
	handle /api/* {
		reverse_proxy control-api:8000 {
			flush_interval -1
		}
	}
	handle /agent/* {
		reverse_proxy agent-ingress:8001 {
			flush_interval -1
		}
	}
	handle /health {
		reverse_proxy control-api:8000 {
			flush_interval -1
		}
	}
	handle {
		reverse_proxy ui:4173
	}
}

ghoststack.rideai.com.au {
	encode gzip
	handle /ghost_chatui {
		redir /ghost_chatui/ 308
	}
	handle_path /ghost_chatui/* {
		reverse_proxy ghost-chatui:3000
	}
	handle /api/* {
		reverse_proxy control-api:8000 {
			flush_interval -1
		}
	}
	handle /agent/* {
		reverse_proxy agent-ingress:8001 {
			flush_interval -1
		}
	}
	handle /health {
		reverse_proxy control-api:8000 {
			flush_interval -1
		}
	}
	handle {
		reverse_proxy ui:4173
	}
}

