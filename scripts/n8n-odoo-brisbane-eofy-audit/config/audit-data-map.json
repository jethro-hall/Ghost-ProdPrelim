{
  "title": "Odoo / Ride Electric Brisbane Audit Data Map and Relevance",
  "purpose": "Tacit operating knowledge for the forensic audit agent. Odoo models form a connected transaction graph — reconstruct it, test completeness, identify anomalies.",
  "transaction_chains": {
    "accounting": [
      "account.move → account.move.line → account.account, account.journal, res.partner, account.tax, product.product",
      "account.move.line → account.partial.reconcile → account.full.reconcile",
      "account.payment → account.move → account.move.line → account.partial.reconcile"
    ],
    "pos": [
      "pos.order → pos.order.line → product.product, product.template, account.tax",
      "pos.order → pos.payment → pos.payment.method",
      "pos.order → pos.session → pos.config",
      "pos.order.account_move → account.move → account.move.line"
    ],
    "product_stock_cogs": [
      "product.product → product.template → product.category → uom.uom",
      "stock.move → stock.move.line, stock.valuation.layer → account.move → account.move.line",
      "stock.move → stock.picking"
    ],
    "reconciliation": [
      "account.move.line → account.partial.reconcile (debit_move_id / credit_move_id)",
      "account.bank.statement.line → account.move"
    ]
  },
  "retail_operating_model": [
    "POS retail sales",
    "customer invoices",
    "supplier bills",
    "product and parts sales",
    "service/repair activity",
    "refunds and credit notes",
    "cash/card/Afterpay receipts",
    "inventory movement",
    "COGS/stock valuation",
    "GST/tax reporting",
    "bank reconciliation",
    "manual journals"
  ],
  "group_structure_note": "Ride Electric Brisbane (company_id 4) is the audit population. Other entities (Retail, Wholesale) exist but are out of scope unless data explicitly supports cross-entity findings.",
