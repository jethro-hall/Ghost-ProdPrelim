{
  "type": "webhook",
  "name": "hubtiger_booking_service_set",
  "description": "Workflow node 3a: Save service type and issue on server session only — fast, no HubTiger write.",
  "disable_interruptions": false,
  "force_pre_tool_speech": "auto",
  "pre_tool_speech": "auto",
  "tool_call_sound": null,
  "tool_call_sound_behavior": "auto",
  "tool_error_handling_mode": "auto",
  "execution_mode": "immediate",
  "api_schema": {
    "url": "https://ghoststack.rideai.com.au/api/elevenlabs/hubtiger/tool",
    "method": "POST",
    "path_params_schema": [],
    "query_params_schema": [],
    "request_body_schema": {
      "id": "body",
      "type": "object",
      "description": "Isolated workflow node after bike confirmed. Pass booking_session_id, service_type (service_full or service_plus), issue_description. For non-standard work set needs_workshop_callback true.\n\nSpeak only the voice_line from the response. Then move to hubtiger_booking_submit node.",
      "properties": [
        {
          "id": "function",
          "type": "string",
          "value_type": "constant",
          "constant_value": "booking_service_set",
          "required": true
        },
        {
          "id": "payload",
          "type": "object",
          "properties": [
            {
              "id": "booking_session_id",
              "type": "string",
              "value_type": "llm_prompt",
              "required": true
            },
            {
              "id": "service_type",
              "type": "string",
              "value_type": "llm_prompt",
              "description": "service_full or service_plus.",
              "required": true
            },
            {
              "id": "issue_description",
              "type": "string",
              "value_type": "llm_prompt",
              "required": true
            },
            {
              "id": "needs_workshop_callback",
              "type": "boolean",
              "value_type": "llm_prompt",
              "required": false
            }
          ],
          "required": true
        }
      ],
      "required": false
    },
    "request_headers": [
      { "type": "value", "name": "Content-Type", "value": "application/json" },
      { "type": "value", "name": "X-Ghost-Voice-Key", "value": "SET_IN_ELEVENLABS_FROM_GHOSTDASH_ENV" }
    ],
    "content_type": "application/json",
    "auth_connection": null
  },
  "assignments": [],
  "response_timeout_secs": 15,
  "dynamic_variables": { "dynamic_variable_placeholders": {} },
  "response_mocks": []
}
