            "size": 1664,
            "mimeType": "application/json",
            "text": "[{\"id\":75,\"question\":\"Warranty reference Number\",\"controlType\":\"TEXTINPUT\",\"hint\":\"If number is not available, type NA and reference all details in the job notes\",\"mandatory\":true,\"linkedServiceTypes\":[163233]},{\"id\":782,\"question\":\"Please provide a brief description of the reason for the consultation.\",\"controlType\":\"TEXTINPUT\",\"hint\":\"For example, you can specify if it is a motor issue, a settings problem, a loss of power, or an error code displayed on the screen.\",\"mandatory\":true,\"linkedServiceTypes\":[163233]},{\"id\":783,\"question\":\"Please have the bike/scooter available during the call to show it to the specialist.\",\"controlType\":\"CHECKBOX\",\"hint\":\"\",\"mandatory\":false,\"linkedServiceTypes\":[163233]},{\"id\":1026,\"question\":\"Customer Full Name \",\"controlType\":\"TEXTINPUT\",\"hint\":\"\",\"mandatory\":true,\"linkedServiceTypes\":[165358,165359,33411]},{\"id\":1027,\"question\":\"Customer Phone number \",\"controlType\":\"TEXTINPUT\",\"hint\":\"\",\"mandatory\":true,\"linkedServiceTypes\":[165358,165359,33411]},{\"id\":1028,\"question\":\"Customer email address \",\"controlType\":\"TEXTINPUT\",\"hint\":\"\",\"mandatory\":true,\"linkedServiceTypes\":[165358,165359,33411]},{\"id\":1029,\"question\":\"Directed Electronics Contact name\",\"controlType\":\"TEXTINPUT\",\"hint\":\"\",\"mandatory\":true,\"linkedServiceTypes\":[165358,165359,33411]},{\"id\":1030,\"question\":\"Directed Electronics Claim number \",\"controlType\":\"TEXTINPUT\",\"hint\":\"\",\"mandatory\":true,\"linkedServiceTypes\":[165358,165359,33411]},{\"id\":1183,\"question\":\"Please confirm make and model of the item/s\",\"controlType\":\"TEXTINPUT\",\"hint\":\"For example, Smartmotion E City or Battery from a Pacer GT.\",\"mandatory\":true,\"linkedServiceTypes\":[163233]}]"
