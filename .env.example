# Copy to .env and keep the real .env uncommitted.
OPENAI_API_KEY=
OPENAI_MODEL=openai/gpt-5.4
OPENAI_BASE_URL=https://api.openai.com/v1

# Embeddings default to the local TEI sidecar on the host GPU.
# Compose now reads APP_DEFAULT_EMBEDDING_MODEL directly so legacy OPENAI_EMBEDDING_MODEL
# values do not keep the stack pinned to text-embedding-3-small.
APP_DEFAULT_EMBEDDING_MODEL=openai/intfloat/multilingual-e5-large-instruct
OPENAI_EMBEDDING_BASE_URL=http://tei-embeddings:80/v1
OPENAI_EMBEDDING_API_KEY=local-tei
# Keep this aligned with the TEI max client/request batch size.
APP_EMBEDDING_BATCH_SIZE=8

# Clean first-generation local vector target for 1024-d multilingual-e5-large-instruct.
APP_QDRANT_COLLECTION=ghostdash_knowledge_e5_v1
APP_QDRANT_VECTOR_SIZE=1024

# Optional: only required for the cloud-assisted rich-document lane.
LLAMA_CLOUD_API_KEY=
LLAMAPARSE_TIER=agentic

# Default ingestion policy for uploads that do not specify a lane.
# local | cloud
DEFAULT_POLICY_LANE=local
DEFAULT_CORPUS=default

# Optional Qdrant auth if you add one later.
QDRANT_API_KEY=

# Optional Qdrant GPU tuning for docker-compose.
# GPU indexing is enabled by default in compose; override only if needed.
QDRANT_GPU_INDEXING=1
QDRANT_GPU_DEVICE_FILTER=
