# Copy to .env and keep the real .env uncommitted.
OPENAI_API_KEY=
OPENAI_MODEL=openai/gpt-5.4
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional shared secret for ElevenLabs/GhostStack voice LLM ingress.
# When set, callers must send X-Ghost-Voice-Key or Authorization: Bearer.
APP_VOICE_INGRESS_SECRET=
APP_VOICE_FIRST_TOKEN_TARGET_MS=1500
APP_VOICE_MAX_OUTPUT_TOKENS=160
APP_VOICE_STREAM_GUARD_HOLDBACK_CHARS=32
APP_VOICE_STT_PROVIDER=deepgram_primary
APP_VOICE_STT_ENDPOINTING_MS=650
APP_VOICE_STT_MAX_ENDPOINTING_MS=900
APP_VOICE_STT_MIN_UTTERANCE_CHARS=2
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2
HUBTIGER_MCP_URL=
HUBTIGER_PROXY_URL=

# Shopify Admin GraphQL sidecar (services/shopify-mcp) + ElevenLabs webhook tools.
# In Docker Compose, control-api and agent-ingress default SHOPIFY_MCP_URL to http://shopify-mcp:8097.
SHOPIFY_MCP_URL=
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_API_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2025-01
SHOPIFY_MCP_READ_TIMEOUT_MS=12000
SHOPIFY_MCP_MAX_PRODUCTS=5
SHOPIFY_MCP_MAX_VARIANTS_PER_PRODUCT=20
# Optional Shopify Admin search fragments for product_search category routing (must match this store).
# ElevenLabs / LLM payload: { "search": "...", "category": "part"|"ebike"|"scooter"|"all" } (aliases: query/q, e-bike).
# Example fragment (adjust to your product_type/tags): product_type:"Electric Bike"
SHOPIFY_SEARCH_FILTER_PART=
SHOPIFY_SEARCH_FILTER_EBIKE=
SHOPIFY_SEARCH_FILTER_SCOOTER=
# In-process catalog cache (product + variant metadata). Price, compare-at, availability, and inventory are always fetched fresh.
SHOPIFY_MCP_CATALOG_CACHE_TTL_SECONDS=60
SHOPIFY_MCP_CATALOG_CACHE_MAX_ENTRIES=200
SHOPIFY_MCP_PING_CACHE_TTL_SECONDS=15
SHOPIFY_MCP_VARIANT_PRICING_CHUNK=80
SHOPIFY_MCP_INVENTORY_LEVELS_FIRST=50
# Dedicated secret for ElevenLabs Shopify webhook tools (separate from Hubtiger).
ELEVENLABS_SHOPIFY_WEBHOOK_SECRET=
HUBTIGER_TOOL_ACCESS=read_only
HUBTIGER_BOOKING_AUTO_EXECUTE=false
HUBTIGER_BASE_URL=https://api.hubtiger.com/v1
HUBTIGER_API_KEY=
HUBTIGER_AUTH_MODE=
HUBTIGER_PORTAL_MODE=
HUBTIGER_PARTNER_ID=
HUBTIGER_FUNCTION_CODE=
HUBTIGER_API_CODE=
HUBTIGER_USERNAME=
HUBTIGER_PASSWORD=
HUBTIGER_CREATED_BY_USER_ID=
HUBTIGER_READ_TIMEOUT_MS=6000
HUBTIGER_CUSTOMER_LOOKUP_TIMEOUT_MS=20000
HUBTIGER_MUTATION_TIMEOUT_MS=12000

# Optional ElevenLabs server-side voice testing.
# Browser code never receives this key.
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=
ELEVENLABS_ALLOWED_VOICE_IDS=
ELEVENLABS_CONVAI_AGENT_ID=

# Voice Ops admin gate for ElevenLabs tool sync (header: X-Operator-Admin-Key).
APP_OPERATOR_ADMIN_KEY=
ELEVENLABS_TEST_TIMEOUT_MS=120000

# Embeddings default to the local TEI sidecar on the host GPU.
# Compose now reads APP_DEFAULT_EMBEDDING_MODEL directly so legacy OPENAI_EMBEDDING_MODEL
# values do not keep the stack pinned to text-embedding-3-small.
APP_DEFAULT_EMBEDDING_MODEL=openai/intfloat/multilingual-e5-large-instruct
# From app containers use the Compose service hostname (not host localhost).
OPENAI_EMBEDDING_BASE_URL=http://tei-embeddings:80/v1
OPENAI_EMBEDDING_API_KEY=local-tei
# Keep this aligned with the TEI max client/request batch size.
APP_EMBEDDING_BATCH_SIZE=8

# Clean first-generation local vector target for 1024-d multilingual-e5-large-instruct.
APP_QDRANT_COLLECTION=ghostdash_knowledge_e5_v1
APP_QDRANT_VECTOR_SIZE=1024

# Optional: only required for the cloud-assisted rich-document lane.
LLAMA_CLOUD_API_KEY=
LLAMAPARSE_TIER=agentic

# Default ingestion policy for uploads that do not specify a lane.
# local | cloud
DEFAULT_POLICY_LANE=local
DEFAULT_CORPUS=default

# Optional Qdrant auth if you add one later.
QDRANT_API_KEY=

# Optional Qdrant GPU tuning for docker-compose.
# GPU indexing is enabled by default in compose; override only if needed.
QDRANT_GPU_INDEXING=1
QDRANT_GPU_DEVICE_FILTER=

# n8n (workflow.rideai.com.au)
# NOTE: generate a stable encryption key once and never rotate it unless you are
# intentionally invalidating stored credentials.
N8N_DB_PASSWORD=
N8N_ENCRYPTION_KEY=
# Brisbane EOFY Claude audit (04_SUB_CLAUDE_AUDIT) — sk-ant-… from console.anthropic.com
ANTHROPIC_API_KEY=

# Optional UI key for Apryse WebViewer.
VITE_APRYSE_LICENSE_KEY=
.EOFY_MCP_TOKEN=
