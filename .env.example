# Copy to .env and keep the real .env uncommitted.
OPENAI_API_KEY=
OPENAI_MODEL=openai/gpt-5.4
OPENAI_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: only required for the cloud-assisted rich-document lane.
LLAMA_CLOUD_API_KEY=
LLAMAPARSE_TIER=agentic

# Default ingestion policy for uploads that do not specify a lane.
# local | cloud
DEFAULT_POLICY_LANE=local
DEFAULT_CORPUS=default

# Optional Qdrant auth if you add one later.
QDRANT_API_KEY=

# Optional Qdrant GPU tuning for docker-compose.
# GPU indexing is enabled by default in compose; override only if needed.
QDRANT_GPU_INDEXING=1
QDRANT_GPU_DEVICE_FILTER=
